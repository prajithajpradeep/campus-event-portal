# Copy to .env to override defaults locally. In docker-compose these are set
# under the backend service's `environment:` block.
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@db:5432/campus

# Generate a strong secret for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin account created automatically on first startup
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=admin123
ADMIN_NAME=Portal Admin

CORS_ORIGINS=http://localhost:5173,http://localhost
